{
  "name": "cognilion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "db:types": "supabase gen types typescript --linked --schema public --schema erp > src/types/database.ts && cp src/types/database.ts supabase/functions/_shared/database.ts",
    "lint": "eslint . --max-warnings 180",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "e2e:serve": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "erp:smoke": "node --env-file=.env scripts/erp-pipeline-smoke.mjs",
    "test": "vitest run",
    "test:functions": "cd supabase/functions && deno task test",
    "test:db": "supabase test db",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "kb:build": "node scripts/build-help-kb-index.mjs",
    "help:shots": "vite build --mode demo --outDir dist-demo && playwright test -c scripts/help-screenshots/playwright.config.ts capture",
    "help:check": "vite build --mode demo --outDir dist-demo && playwright test -c scripts/help-screenshots/playwright.config.ts check"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@floating-ui/react": "^0.27.20",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-virtual": "^3.14.23",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "jspdf": "^4.2.0",
    "livekit-client": "2.23.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
