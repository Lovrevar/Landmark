{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(npm run kb:build)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)"
    ],
    "ask": [
      "Bash(npm run db:types)",
      "Bash(npm run erp:smoke)",
      "Bash(supabase db *)",
      "Bash(npx supabase db *)",
      "Bash(supabase migration *)",
      "Bash(npx supabase migration *)",
      "Bash(supabase link *)",
      "Bash(npx supabase link *)",
      "Bash(supabase gen *)",
      "Bash(npx supabase gen *)",
      "Bash(supabase functions deploy *)",
      "Bash(npx supabase functions deploy *)",
      "Bash(supabase secrets *)",
      "Bash(npx supabase secrets *)",
      "Bash(psql *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.demo)",
      "Read(./.env.test)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-tests.mjs\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.mjs\"", "timeout": 300 }
        ]
      }
    ]
  }
}
