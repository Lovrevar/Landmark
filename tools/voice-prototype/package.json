{
  "name": "cognilion-voice-prototype",
  "private": true,
  "type": "module",
  "description": "Phase 0 live prototype: LiveKit + Soniox + ElevenLabs with a stub LLM, measuring barge-in and latency",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "livekit": "$HOME/.local/opt/livekit-1.13.10/bin/livekit-server --dev",
    "stub-llm": "node src/stub-llm.ts",
    "agent": "node src/agent.ts dev",
    "web": "node src/server.ts",
    "report": "node src/report.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@livekit/agents": "1.9.3",
    "@livekit/agents-plugin-elevenlabs": "1.9.3",
    "@livekit/agents-plugin-openai": "1.9.3",
    "@livekit/agents-plugin-silero": "1.9.3",
    "@livekit/agents-plugin-soniox": "1.9.3",
    "@livekit/rtc-node": "1.2.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-virtual": "^3.14.26",
    "i18next": "^26.7.1",
    "livekit-server-sdk": "2.19.2",
    "onnxruntime-node": "1.30.0",
    "openai": "7.42.0",
    "react-i18next": "^17.1.12"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "0.6.1"
    }
  }
}
